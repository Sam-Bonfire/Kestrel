    {
      "parameters": {
        "language": "javaScript",
        "mode": "runOnceForAllItems",
        "jsCode": "const req = $('Guard').first().json;\nconst rows = $input.all().map((item) => item.json);\nconst row = rows.find((entry) => entry.app === req.app && entry.form === req.form);\n\nconst fail = (status, error) => [{ json: { ...req, authorized: false, status, error } }];\n\nif (!row) return fail(400, 'unknown form');\n\nconst expected = String(row.token ?? '');\nif (expected !== '' && req.token !== expected) return fail(401, 'unauthorized');\n\n// Attachments are data URLs; Notion cannot fetch them. Refuse instead of dropping silently.\nif (typeof req.fields.attachment === 'string' && req.fields.attachment !== '') {\n  return fail(415, 'this receiver does not store attachments');\n}\n\nconst secret = $env.TURNSTILE_SECRET ?? '';\nconst turnstileToken = typeof req.meta.turnstile === 'string' ? req.meta.turnstile : '';\nif (secret !== '' && turnstileToken === '') return fail(400, 'missing verification token');\n\nconst databaseId = String(row.databaseId ?? '').trim();\nif (databaseId === '') return fail(500, 'registry row has no databaseId');\n\nlet propertyMap = {};\nif (row.propertyMap) {\n  try {\n    propertyMap = JSON.parse(row.propertyMap);\n  } catch {\n    return fail(500, 'registry propertyMap is not valid JSON');\n  }\n}\n\nconst text = (value) => String(value).slice(0, 2000);\n\nconst toProperty = (type, value) => {\n  switch (type) {\n    case 'title':\n      return { title: [{ text: { content: text(value) } }] };\n    case 'email':\n      return { email: text(value) };\n    case 'url':\n      return { url: text(value) };\n    case 'phone_number':\n      return { phone_number: text(value) };\n    case 'select':\n      return { select: { name: text(value) } };\n    case 'number': {\n      const parsed = Number(value);\n      return { number: Number.isFinite(parsed) ? parsed : null };\n    }\n    case 'checkbox':\n      return { checkbox: value === true || value === 'true' };\n    case 'date':\n      return { date: { start: text(value) } };\n    default:\n      return { rich_text: [{ text: { content: text(value) } }] };\n  }\n};\n\nconst properties = {};\nlet titleValue = '';\nlet titleName = String(row.titleProperty ?? '').trim();\nfor (const [key, value] of Object.entries(req.fields)) {\n  if (key === '_hp' || key.startsWith('attachment')) continue;\n  const mapped = propertyMap[key] ?? {};\n  const name = mapped.name ?? key;\n  const type = mapped.type ?? 'rich_text';\n  if (type === 'title') {\n    titleValue = text(value);\n    titleName = name;\n    continue;\n  }\n  properties[name] = toProperty(type, value);\n}\nif (titleName === '') titleName = 'Name';\nif (titleValue === '') {\n  titleValue = text(req.fields.name || req.fields.email || `${req.app} ${req.form}`);\n}\nproperties[titleName] = toProperty('title', titleValue);\n\nconst page = { parent: { database_id: databaseId }, properties };\n\nreturn [{ json: {\n  ...req,\n  authorized: true,\n  status: 200,\n  needsTurnstile: secret !== '' && turnstileToken !== '',\n  turnstileToken,\n  databaseId,\n  notifyUrl: String(row.notifyUrl ?? ''),\n  page,\n} }];"
      },
