    {
      "parameters": {
        "language": "javaScript",
        "mode": "runOnceForAllItems",
        "jsCode": "const req = $input.first().json;\nconst body = req.body && typeof req.body === 'object' ? req.body : {};\nconst headers = req.headers ?? {};\nconst fields = body.fields && typeof body.fields === 'object' ? body.fields : null;\n\nconst reject = (status, error) => [{ json: { ok: false, status, error } }];\n\nif (!fields) return reject(400, 'bad payload');\n\nconst app = typeof body.app === 'string' ? body.app : '';\nconst form = typeof body.form === 'string' ? body.form.trim() : '';\nif (!['landing', 'mail', 'calendar'].includes(app) || form === '') {\n  return reject(400, 'unknown form');\n}\n\nif (JSON.stringify(body).length > 32 * 1024) return reject(413, 'payload too large');\n\n// A filled honeypot is a bot. Answer 200 and do nothing, so it learns nothing.\nif (typeof fields._hp === 'string' && fields._hp !== '') return reject(200, '');\n\nconst authorization = String(headers.authorization ?? '');\nconst rawToken = headers['x-token'] ?? authorization.replace(/^Bearer\\s+/i, '');\nconst token = String(rawToken ?? '').trim();\n\nconst forwarded = String(headers['x-forwarded-for'] ?? '').split(',')[0].trim();\nconst ip = forwarded || String(headers['x-real-ip'] ?? '') || 'unknown';\n\n// Per-IP, per-form sliding window kept in workflow static data.\nconst now = Date.now();\nconst windowMs = 60000;\nconst limit = 5;\nconst store = $getWorkflowStaticData('global');\nconst rateLimit = (store.rateLimit = store.rateLimit ?? {});\nif (Object.keys(rateLimit).length > 500) {\n  for (const [key, hits] of Object.entries(rateLimit)) {\n    if (!hits.some((at) => now - at < windowMs)) delete rateLimit[key];\n  }\n}\nconst bucket = `${ip}|${app}|${form}`;\nconst hits = (rateLimit[bucket] ?? []).filter((at) => now - at < windowMs);\nif (hits.length >= limit) return reject(429, 'too many submissions, try again later');\nhits.push(now);\nrateLimit[bucket] = hits;\n\nreturn [{ json: { ok: true, app, form, fields, meta: body.meta ?? {}, token, ip } }];"
      },
