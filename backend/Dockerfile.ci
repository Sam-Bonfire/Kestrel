FROM debian:bookworm-slim AS runner

RUN apt-get update && apt-get install -y \
    ca-certificates \
    curl \
    libssl3 \
    libsqlite3-0 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY target/release/kestrel-server /usr/local/bin/kestrel-server
COPY target/wasm32-wasip1/release/gmail.wasm /app/plugins/gmail.wasm
COPY target/wasm32-wasip1/release/outlook.wasm /app/plugins/outlook.wasm
EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD curl -f http://localhost:${PORT:-8080}/api/v1/health || exit 1

ENTRYPOINT ["/usr/local/bin/kestrel-server"]
