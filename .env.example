# ──────────────────────────────────────────────
# Kestrel Backend Configuration
# ──────────────────────────────────────────────
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# ── Database ──────────────────────────────────
# SQLite (default, zero-config):
DATABASE_URL=sqlite:/app/data/kestrel.db
# PostgreSQL (for multi-user deployments):
# DATABASE_URL=postgresql://kestrel:password@localhost:5432/kestrel

# ── Server ────────────────────────────────────
PORT=8080
HOST=0.0.0.0
RUST_LOG=info,kestrel=debug

# Session secret for cookie-based auth.
# Generate one: openssl rand -base64 32
SESSION_SECRET=

# ── Networking ────────────────────────────────
# The public URL where clients reach this server.
# Examples:
#   Cloudflare Tunnel: https://kestrel.yourdomain.com
#   Tailscale: http://100.x.x.x:8080
#   Local dev: http://127.0.0.1:8080
KESTREL_BASE_URL=http://127.0.0.1:8080

# ── OAuth Providers (optional) ────────────────
# Google (Gmail + Google Calendar)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Microsoft (Outlook + Outlook Calendar)
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# ── Sync ──────────────────────────────────────
SYNC_INTERVAL_MINUTES=5

# ── Plugins ───────────────────────────────────
PLUGINS_DIR=/app/plugins
