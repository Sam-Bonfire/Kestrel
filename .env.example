# Database Config (supports SQLite file path or PostgreSQL connection strings)
DATABASE_URL=sqlite:/app/data/kestrel.db

# Server Config
PORT=8080
HOST=0.0.0.0
RUST_LOG=info,kestrel=debug
SESSION_SECRET=replace_with_a_long_random_session_secret_for_production
JWT_SECRET=
PLUGINS_DIR=/app/plugins

# OAuth Provider Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Canonical base URL for OAuth redirects and API calls
KESTREL_BASE_URL=http://localhost:8080

# Background Sync Configurations
SYNC_INTERVAL_MINUTES=5
